@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		--background: 220 14.3% 4.1%;
		--foreground: 0 0% 95%;
		--card: 24 9.8% 10%;
		--card-foreground: 0 0% 95%;
		--popover: 220 14.3% 4.1%;
		--popover-foreground: 0 0% 95%;
		--primary: 217 91% 60%;
		--primary-foreground: 355.7 100% 97.3%;
		--secondary: 240 3.7% 15.9%;
		--secondary-foreground: 0 0% 98%;
		--muted: 0 0% 15%;
		--muted-foreground: 240 5% 64.9%;
		--accent: 213 94% 68%;
		--accent-foreground: 0 0% 98%;
		--destructive: 0 62.8% 30.6%;
		--destructive-foreground: 0 85.7% 97.3%;
		--border: 240 3.7% 15.9%;
		--input: 240 3.7% 15.9%;
		--ring: 346.8 77.2% 49.8%;
		--radius: 0.5rem;
	}
}

@layer base {
	* {
		@apply border-border;
	}
	body {
		@apply bg-background text-foreground;
	}

	::-webkit-scrollbar {
		width: 0.75rem;
	}

	::-webkit-scrollbar-track {
		border-radius: 100vh;
	}

	::-webkit-scrollbar-thumb {
		background: #3b82f6;
		border-radius: 100vh;
		border: 3px solid #090a0c;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #3b83f6c0;
	}
}

@layer md {
	.md {
		@apply flex;
		@apply flex-col;
		@apply gap-2;
	}

	.md a {
		@apply inline-block;
		@apply break-all;
		@apply text-blue-600;
		@apply underline;
	}
	.md a:hover {
		@apply text-blue-800;
	}
	.md a:visited {
		@apply text-purple-600;
	}

	.md blockquote {
		@apply border-l-4;
		@apply pl-2;
		@apply text-zinc-400;
	}

	.md h1 {
		@apply text-lg;
		@apply font-semibold;
	}
	.md h2 {
		@apply text-lg;
		@apply font-medium;
	}
	.md h3 {
		@apply font-medium;
	}
	.md img {
		@apply mt-0.5;
		@apply max-h-64;
		@apply max-w-96;
	}
	.md ol {
		@apply list-inside;
		@apply list-decimal;
		@apply pl-2;
	}
	.md ul {
		@apply list-inside;
		@apply list-disc;
		@apply pl-2;
	}
	.md thead {
		@apply border-b-2;
	}
	.md td {
		@apply w-fit;
	}
	.md th {
		@apply px-2;
	}
}
