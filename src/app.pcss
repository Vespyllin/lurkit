@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
	:root {
		--background: 348 2% 4%;
		--foreground: 0 0% 95%;
		--card: 24 9.8% 10%;
		--card-foreground: 0 0% 95%;
		--popover: 0 0% 6%;
		--popover-foreground: 0 0% 95%;
		--primary: 348 100% 50%;
		--primary-foreground: 355.7 100% 97.3%;
		--secondary: 240 3.7% 15.9%;
		--secondary-foreground: 0 0% 98%;
		--muted: 0 0% 15%;
		--muted-foreground: 240 5% 64.9%;
		--accent: 332 100% 57%;
		--accent-foreground: 0 0% 98%;
		--destructive: 0 62.8% 30.6%;
		--destructive-foreground: 0 85.7% 97.3%;
		--border: 240 3.7% 15.9%;
		--input: 240 3.7% 15.9%;
		--ring: 346.8 77.2% 49.8%;
		--radius: 0.5rem;

		--sidebar-background: 0 0% 98%;
		--sidebar-foreground: 240 5.3% 26.1%;
		--sidebar-primary: 240 5.9% 10%;
		--sidebar-primary-foreground: 0 0% 98%;
		--sidebar-accent: 240 4.8% 95.9%;
		--sidebar-accent-foreground: 240 5.9% 10%;
		--sidebar-border: 220 13% 91%;
		--sidebar-ring: 217.2 91.2% 59.8%;
	}
}

@layer base {
	* {
		@apply border-border;
	}
	body {
		@apply bg-background text-foreground;
	}

	::-webkit-scrollbar {
		width: 0.75rem;
	}

	::-webkit-scrollbar-track {
		border-radius: 100vh;
	}

	::-webkit-scrollbar-thumb {
		background: #ff0033;
		border-radius: 100vh;
		border: 3px solid #090a0c;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #ff0033c0;
	}

	.md {
		@apply space-y-3;
	}

	.md a {
		@apply text-red-500;
	}

	.md a {
		@apply inline-block;
		@apply break-all;
		@apply text-blue-600;
		@apply underline;
	}

	.md a:hover {
		@apply text-blue-800;
	}

	.md a:visited {
		@apply text-purple-600;
	}

	.md blockquote {
		@apply border-l-4;
		@apply pl-2;
		@apply text-zinc-400;
	}

	.md h1 {
		@apply text-lg;
		@apply font-semibold;
	}
	.md h2 {
		@apply text-lg;
		@apply font-medium;
	}
	.md h3 {
		@apply font-medium;
	}

	.md img {
		@apply max-w-full;
		@apply lg:max-h-96;
		@apply inline;
	}

	.md ol {
		@apply space-y-1.5;
		@apply list-outside;
		@apply list-decimal;
		@apply pl-4;
	}

	.md ul {
		@apply space-y-1.5;
		@apply list-outside;
		@apply list-disc;
		@apply pl-4;
	}

	.md thead {
		@apply border-b-2;
	}
	.md td {
		@apply w-fit;
	}
	.md th {
		@apply px-2;
	}

	.md code {
		@apply text-wrap;
	}
}

@layer utilities {
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
}
